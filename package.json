{
  "name": "storm-ki-telefonzentrale",
  "version": "1.0.0",
  "private": true,
  "description": "KI-Telefonzentrale für die Storm GmbH – Twilio, Retell AI / Vapi, Microsoft Graph (Outlook)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:postgres": "node scripts/prisma-postgres.mjs && prisma generate --schema=prisma/postgres/schema.prisma && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "setup": "prisma db push && prisma db seed",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "@prisma/client": "^6.19.3",
    "lucide-react": "^0.460.0",
    "next": "^15.5.28",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.31",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
