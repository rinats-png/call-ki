# ═══════════════ KI-Telefonzentrale – Server-Konfiguration ═══════════════
# Kopieren nach .env und ausfüllen. Mandanten-spezifisches (Firmenname, Team,
# Geschäftszeiten, KI-Texte) wird NICHT hier, sondern im Dashboard gepflegt.

# ─── Server / Domain (docker-compose) ───
DOMAIN=app.ihre-domain.de                 # DNS A-Record → IP des VPS
ACME_EMAIL=admin@ihre-domain.de           # für Let's-Encrypt-Benachrichtigungen
POSTGRES_PASSWORD=                        # langes Zufallspasswort: openssl rand -hex 24

# Lokale Entwicklung ohne Docker (bei docker-compose automatisch gesetzt):
DATABASE_URL=postgresql://callki:callki@localhost:5432/callki
PUBLIC_BASE_URL=http://localhost:3000

# ─── Sicherheit ───
SETUP_TOKEN=                              # einmalig für /setup (erster Plattform-Admin): openssl rand -hex 16
CRON_SECRET=                              # Löschfristen-Job: openssl rand -hex 24
VOICE_TOOL_SECRET=                        # Header x-tool-secret für Retell-Funktionen: openssl rand -hex 24
APP_ENCRYPTION_KEY=                       # PFLICHT: verschlüsselt 2FA-Secrets in der DB: openssl rand -hex 32 (nie ändern/verlieren!)
REQUIRE_PLATFORM_ADMIN_2FA=true           # 2FA für Plattform-Admins erzwingen (nur lokal abschalten)
REQUIRE_TENANT_ADMIN_2FA=false            # optional: auch für Kunden-Admins erzwingen

# ─── Twilio (Telefonie, ein Plattform-Konto) ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURE=true
TWILIO_SMS_FROM=                          # optional: SMS-fähige Nummer oder Messaging-Service-SID (MG…)

# ─── Retell AI (Sprach-KI) ───
RETELL_API_KEY=
RETELL_AGENT_ID=                          # Standard-Agent für alle Kunden (je Nummer überschreibbar)
RETELL_SIP_DOMAIN=sip.retellai.com
RETELL_AGENT_ID_NO_STORAGE=               # optional: Agent mit Datenspeicherung "basic_attributes_only" für Kunden ohne Aufzeichnung

# ─── E-Mail-Versand (SMTP, z. B. IONOS-Postfach, Brevo, Postmark) ───
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KI-Telefonzentrale <noreply@ihre-domain.de>

# ─── Microsoft 365 (optional, eine mandantenfähige Entra-App) ───
MS_CLIENT_ID=
MS_CLIENT_SECRET=

PLATFORM_NAME=KI-Telefonzentrale
# Impressum und Datenschutzerklärung des Betreibers (Vorlagen: docs/recht/) – Links im Fuß von Portal und Login
LEGAL_IMPRINT_URL=
LEGAL_PRIVACY_URL=
