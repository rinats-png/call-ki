# ═══════════════ KI-Telefonzentrale – Server-Konfiguration ═══════════════
# Kopieren nach .env und ausfüllen. Mandanten-spezifisches (Firmenname, Team,
# Geschäftszeiten, KI-Texte) wird NICHT hier, sondern im Dashboard gepflegt.

# ─── Server / Domain (docker-compose) ───
DOMAIN=app.ihre-domain.de                 # DNS A-Record → IP des VPS
ACME_EMAIL=admin@ihre-domain.de           # für Let's-Encrypt-Benachrichtigungen
POSTGRES_PASSWORD=                        # langes Zufallspasswort: openssl rand -hex 24

# Lokale Entwicklung ohne Docker (bei docker-compose automatisch gesetzt):
DATABASE_URL=postgresql://callki:callki@localhost:5432/callki
PUBLIC_BASE_URL=http://localhost:3000

# ─── Sicherheit ───
SETUP_TOKEN=                              # einmalig für /setup (erster Plattform-Admin): openssl rand -hex 16
CRON_SECRET=                              # zeitgesteuerte Aufgaben (deploy/cron.sh): openssl rand -hex 24
# Webhook-Geheimnis je Sprach-KI-Anbieter (Header x-tool-secret bzw. x-vapi-secret): openssl rand -hex 24
VOICE_TOOL_SECRET_RETELL=
VOICE_TOOL_SECRET_VAPI=
VOICE_TOOL_SECRET_ELEVENLABS=
VOICE_TOOL_SECRET_SIP=
VOICE_TOOL_SECRET=                        # alt, gemeinsam für alle – gilt nur, solange keines der vier oben gesetzt ist
APP_ENCRYPTION_KEY=                       # PFLICHT: verschlüsselt 2FA-Secrets, Anbieter-Schlüssel aus der Oberfläche, Google-Tokens: openssl rand -hex 32 (nie verlieren!)
APP_ENCRYPTION_KEYS_OLD=                  # nur beim Schlüsselwechsel: frühere Schlüssel, kommagetrennt (docs/betrieb.md → „Schlüsselwechsel“)
REQUIRE_PLATFORM_ADMIN_2FA=true           # 2FA für Plattform-Admins erzwingen (nur lokal abschalten)
REQUIRE_TENANT_ADMIN_2FA=false            # optional: auch für Kunden-Admins erzwingen
COOKIE_SECURE=                            # leer = automatisch (Produktion: Secure-Cookies); „false“ nur für HTTP ohne TLS
PWNED_CHECK=true                          # neue Passwörter gegen bekannte Lecks prüfen (k-Anonymität, Have I Been Pwned)
RECORDING_HOSTS=api.twilio.com,retellai.com,cloudfront.net,amazonaws.com   # erlaubte Hosts für Aufnahme-Abruf (SSRF-Schutz)

# ─── Twilio (Telefonie, ein Plattform-Konto) ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURE=true            # „false“ nur für lokale Tests – in Produktion wird immer geprüft
TWILIO_SMS_FROM=                          # optional: SMS-fähige Nummer oder Messaging-Service-SID (MG…)

# ─── Retell AI (Sprach-KI) ───
RETELL_API_KEY=
RETELL_AGENT_ID=                          # Standard-Agent für alle Kunden (je Nummer überschreibbar)
RETELL_SIP_DOMAIN=sip.retellai.com
RETELL_AGENT_ID_NO_STORAGE=               # optional: Agent mit Datenspeicherung "basic_attributes_only" für Kunden ohne Aufzeichnung

# ─── Weitere Sprach-KI-Anbieter (alles auch in der Oberfläche einstellbar: Verwaltung → Plattform) ───
VOICE_PROVIDER=retell                     # Standard: retell | vapi | elevenlabs | sip:<id>
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_SIP_HOST=sip.vapi.ai                 # EU (Vapi Premier): sip.eu.vapi.ai
VAPI_API_BASE=                            # leer = https://api.vapi.ai
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_BASE=                      # leer = https://api.elevenlabs.io (EU-Datenresidenz: https://api.eu.residency.elevenlabs.io)
ELEVENLABS_WEBHOOK_SECRET=                # Post-call-Webhook (HMAC)
# SIP-Anbieter: SIP_<ID>_URI, z. B. SIP_BLAND_URI=sip:agent@…

# ─── E-Mail-Versand (SMTP, z. B. IONOS-Postfach, Brevo, Postmark) ───
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KI-Telefonzentrale <noreply@ihre-domain.de>

# ─── Microsoft 365 (optional, eine mandantenfähige Entra-App) ───
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ─── Google Kalender (optional) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PLATFORM_NAME=KI-Telefonzentrale
STATUS_NOTICE=                             # Hinweis auf der öffentlichen Statusseite /status (leer = keiner)
# Rechnungen (Pflichtangaben § 14 UStG; ohne Name, Anschrift und Steuernummer keine Rechnungen)
INVOICE_ISSUER_NAME=
INVOICE_ISSUER_ADDRESS=
INVOICE_TAX_ID=
INVOICE_IBAN=
INVOICE_EMAIL=
INVOICE_PAYMENT_DAYS=14
# Impressum und Datenschutzerklärung des Betreibers (Vorlagen: docs/recht/) – Links im Fuß von Portal und Login
LEGAL_IMPRINT_URL=
LEGAL_PRIVACY_URL=

# ─── Karten & Fahrzeiten (optional, Zusatzoption Einsatzplanung; auch in der Oberfläche) ───
# MAPS_PROVIDER=ors   # ors = OpenRouteService, osm = eigene Nominatim-/OSRM-Server, leer = Schätzung
MAPS_PROVIDER=
ORS_API_KEY=
NOMINATIM_URL=
OSRM_URL=

# ─── Überwachung & Alarme (docs/betrieb.md) ───
ALERT_EMAIL=                              # leer = alle Plattform-Admins
ALERT_SMS=                                # nur kritische Alarme
ALERT_WEBHOOK_URL=                        # optional, z. B. Slack/Teams/ntfy
HEALTHCHECK_PING_URL=                     # externer Lebenszeichen-Dienst, z. B. https://hc-ping.com/…
# BACKUP_EXPECTED=true setzt docker-compose automatisch

# ─── Kostenschutz ───
AI_KILL_SWITCH=off                        # on = alle Anrufe an Fallback-Nummer bzw. Mailbox
MAX_CALL_MINUTES=20
MAX_CONCURRENT_CALLS_PER_TENANT=5
MAX_CONCURRENT_CALLS_TOTAL=50
PLATFORM_DAILY_MINUTE_LIMIT=              # leer = aus
SMS_ALLOWED_PREFIXES=+49,+43,+41         # SMS nur in diese Länder (Schutz vor SMS-Pumping)

# ─── Abrechnung (Einkaufspreise für die Marge, netto) ───
VAT_PERCENT=19
COST_TELEPHONY_CENTS_PER_MIN=1.5
COST_VOICE_CENTS_PER_MIN=10
COST_SMS_CENTS=10                         # Twilio-SMS nach DE ca. 9,9 ct (17-kosten.md)

# ─── Nur Testumgebung ───
DEMO_SEED=false                           # true = Test-Kunden einmalig anlegen (nie in Produktion)

# ── Backups (docs/betrieb.md → „Backups“) ──
# Öffentlicher age-Schlüssel (age1…). Den privaten Schlüssel als ./secrets/backup-age.key ablegen
# (chmod 600) UND getrennt vom Server sichern (Passwort-Manager/Tresor) – sonst sind Backups wertlos.
BACKUP_AGE_RECIPIENT=
# Externer Speicher (S3-kompatibel, z. B. IONOS Object Storage)
BACKUP_S3_ENDPOINT=                      # z. B. https://s3.eu-central-3.ionoscloud.com
BACKUP_S3_REGION=                        # z. B. eu-central-3
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
