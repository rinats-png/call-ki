# ───────── Allgemein ─────────
# Öffentliche Basis-URL (für Twilio-Signaturprüfung hinter Proxies/Tunneln), z. B. https://hub.storm.gmbh
PUBLIC_BASE_URL=
# Dashboard-Login (HTTP Basic Auth). In Produktion PFLICHT.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# ───────── Twilio ─────────
TWILIO_AUTH_TOKEN=
# Nur für lokale Tests ohne Twilio auf "false" setzen
TWILIO_VALIDATE_SIGNATURE=true
# Weiterleitung, falls die Sprach-KI nicht erreichbar ist (E.164)
BACKOFFICE_FALLBACK_NUMBER=

# ───────── Sprach-KI ─────────
# retell | vapi
VOICE_PROVIDER=retell
# Gemeinsames Secret für Tool-Calls & Events (Header x-tool-secret / Vapi Server URL Secret)
VOICE_TOOL_SECRET=
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_SIP_DOMAIN=5t4n6j0wnrl.sip.livekit.cloud

# ───────── Microsoft Graph (App-Only) ─────────
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Postfach für E-Mail-Entwürfe (leer = Postfach des zugewiesenen Technikers)
MS_DRAFT_MAILBOX=info@storm.gmbh

# ───────── Terminlogik ─────────
BUSINESS_TIMEZONE=Europe/Berlin
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=18
APPOINTMENT_DURATION_MIN=60

# Seed: Demo-Tickets anlegen
SEED_DEMO_DATA=false
