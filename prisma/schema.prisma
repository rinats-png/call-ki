// Mandantenfähiges Datenmodell der KI-Telefonzentrale.
// Plattform (du) → Tenant (deine Kunden, z. B. Storm GmbH) → deren Anrufer (Customer), Mitarbeiter, Tickets.
// Jede fachliche Tabelle trägt tenantId; Zugriffe laufen ausschließlich über tenant-gebundene Services.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"] // Docker (Alpine) und Netlify-Testumgebung
}

// ───────────────────────────── Plattform & Zugang

model Tenant {
  id                      String    @id @default(cuid())
  slug                    String    @unique
  name                    String
  industry                String    @default("general") // Branchenvorlage: pest_control, trades, general
  status                  String    @default("ONBOARDING") // ONBOARDING, ACTIVE, PAUSED
  timezone                String    @default("Europe/Berlin")
  logoUrl                 String?
  /// Mandanten-Einstellungen (KI, Geschäftszeiten, Termine, Benachrichtigungen) – Schema: src/lib/tenant/settings.ts
  settings                Json      @default("{}")
  plan                    String    @default("STARTER")
  monthlyMinuteLimit      Int?
  /// Auftragsverarbeitungsvertrag (Art. 28 DSGVO): Version der Vorlage und Abschlussdatum.
  /// Ohne beide Angaben kann der Mandant nicht auf ACTIVE gesetzt werden.
  avvVersion              String?
  avvSignedAt             DateTime?
  /// Paket (Preise, Freiminuten, Überminuten) – Einzelwerte je Kunde überschreibbar
  planId                  String?
  planRef                 Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  priceOverrideCents      Int?
  includedMinutesOverride Int?
  overageCentsOverride    Int?
  billingNote             String?
  /// Rechnungsanschrift (mehrzeilig) und USt-IdNr. des Kunden – Pflichtangaben auf Rechnungen
  billingAddress          String?
  billingVatId            String?
  /// Sprach-KI dieses Kunden (leer = Plattform-Standard), z. B. retell, vapi, elevenlabs, sip:bland
  voiceProvider           String?
  /// Agent/Assistent beim Anbieter (leer = Standard-Agent des Anbieters)
  voiceAgentId            String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  users              User[]
  phoneNumbers       PhoneNumber[]
  integrations       Integration[]
  customers          Customer[]
  employees          Employee[]
  tickets            CallTicket[]
  calls              Call[]
  messages           Message[]
  auditLogs          AuditLog[]
  minuteTopUps       MinuteTopUp[]
  planChangeRequests PlanChangeRequest[]
  webhookEndpoints   WebhookEndpoint[]
  services           Service[]
  bills              Bill[]
  jobReports         JobReport[]
  addons             TenantAddon[]
  bankTransactions   BankTransaction[]
  tasks              Task[]
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  passwordHash  String?
  role          String // PLATFORM_ADMIN, TENANT_ADMIN, TENANT_USER
  tenantId      String?
  tenant        Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  failedLogins  Int         @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  disabled      Boolean     @default(false)
  /// TOTP-Secret, AES-256-GCM-verschlüsselt (APP_ENCRYPTION_KEY)
  totpSecretEnc String?
  totpEnabledAt DateTime?
  /// Zuletzt akzeptierter TOTP-Zeitschritt (Schutz gegen Wiederverwendung)
  totpLastStep  Int?
  /// SHA-256-Hashes der Wiederherstellungscodes
  recoveryCodes String[]    @default([])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  tokens        AuthToken[]
  tasks         Task[]

  @@index([tenantId])
}

model Session {
  id             String   @id // SHA-256 des Cookie-Tokens
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Plattform-Admins können in einen Mandanten wechseln ("Als Kunde öffnen")
  activeTenantId String?
  /// false, solange der zweite Faktor noch aussteht
  mfaVerified    Boolean  @default(true)
  /// Zeitpunkt der letzten Passwort-/2FA-Bestätigung (Re-Auth für sensible Aktionen)
  authAt         DateTime @default(now())
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  userAgent      String?

  @@index([userId])
}

model AuthToken {
  id        String    @id // SHA-256 des Tokens
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // INVITE, PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ───────────────────────────── Telefonie & Integrationen

model PhoneNumber {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  e164           String   @unique // Twilio-Nummer, auf die der Kunde umleitet
  label          String?
  /// Optional eigener Agent je Nummer (sonst Mandanten- bzw. Plattform-Standard)
  voiceAgentId   String?
  /// Optional anderer Sprach-KI-Anbieter je Nummer (sonst wie Mandant)
  voiceProvider  String?
  /// Weiterleitung, wenn KI nicht verfügbar / Kontingent erschöpft
  fallbackNumber String?
  createdAt      DateTime @default(now())

  @@index([tenantId])
}

model Integration {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      String // MICROSOFT_365 (Erweiterung: GOOGLE_CALENDAR, CRM_*)
  status    String   @default("PENDING") // PENDING, CONNECTED, ERROR, DISCONNECTED
  /// Nicht-geheime Konfiguration (z. B. Microsoft-Tenant-ID, Entwurfs-Postfach)
  config    Json     @default("{}")
  /// Geheime Zugangsdaten (z. B. Google-Refresh-Token), AES-256-GCM-verschlüsselt
  secretEnc String?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, type])
}

// ───────────────────────────── Fachdaten je Mandant

model Customer {
  id                String       @id @default(cuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String?
  companyName       String?
  phone             String
  email             String?
  address           String?
  postalCode        String?
  customerType      String       @default("PRIVATE") // PRIVATE, BUSINESS, PROPERTY_MANAGEMENT
  status            String       @default("NEW") // NEW, EXISTING
  notes             String?
  /// SMS-Einwilligung (Zeitpunkt + Quelle, z. B. call:<id>) und Widerspruch (z. B. „STOP“ bei Twilio)
  smsConsentAt      DateTime?
  smsConsentSource  String?
  smsOptOutAt       DateTime?
  /// Letzte Bitte um Bewertung (höchstens alle 90 Tage)
  reviewRequestedAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  tickets           CallTicket[]
  calls             Call[]

  bills Bill[]

  @@unique([tenantId, phone])
}

model Employee {
  id                 String            @id @default(cuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  role               String // FIELD_TECH, EMERGENCY_TECH, SPECIALIST, BACKOFFICE
  email              String? // Kalender (Microsoft 365) und Benachrichtigungen
  servicePostalCodes String            @default("*") // Kommagetrennt: 10115, 12, 13000-13999, *
  directPhone        String?
  /// Gewerke, kommagetrennt (z. B. "Sanitär, Heizung"); leer = alle Gewerke
  trades             String            @default("")
  active             Boolean           @default(true)
  appToken           EmployeeAppToken?
  /// Startpunkt für Fahrzeiten (leer = Betriebsadresse aus Einstellungen → Einsatzplanung)
  baseAddress        String?
  /// Einsatzgebiet nach Fahrzeit: höchstens so viele Minuten Anfahrt (leer = Gebiet nach PLZ)
  maxTravelMin       Int?
  createdAt          DateTime          @default(now())
  tickets            CallTicket[]
  jobReports         JobReport[]

  @@index([tenantId])
}

model Call {
  id                 String       @id @default(cuid())
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider           String       @default("retell")
  providerCallId     String?      @unique
  twilioCallSid      String?      @unique
  fromNumber         String
  toNumber           String
  customerId         String?
  customer           Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status             String       @default("RINGING") // RINGING, IN_PROGRESS, ENDED, FAILED, FALLBACK, VOICEMAIL
  startedAt          DateTime     @default(now())
  endedAt            DateTime?
  durationSec        Int?
  /// Gesprächsdauer laut Twilio (StatusCallback) – unabhängig vom KI-Anbieter, Grundlage der Abrechnung
  twilioDurationSec  Int?
  /// Einwilligung des Anrufers in die Tonaufzeichnung (GRANTED/DENIED, Tool recording_consent) mit Zeitpunkt
  recordingConsent   String?
  recordingConsentAt DateTime?
  transcript         String?
  summary            String?
  recordingUrl       String?
  endReason          String?
  /// Zeitpunkt, zu dem Aufnahme/Transkript beim Anbieter (Retell/Twilio) gelöscht wurden
  providerPurgedAt   DateTime?
  tickets            CallTicket[]

  @@index([tenantId, startedAt])
}

model CallTicket {
  id                 String     @id @default(cuid())
  tenantId           String
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  callId             String?
  call               Call?      @relation(fields: [callId], references: [id], onDelete: SetNull)
  assignedEmployeeId String?
  assignedEmployee   Employee?  @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  category           String? // Anliegen laut Branchenvorlage, z. B. Wespen, Rohrbruch
  /// Leistung aus dem Katalog (Dauer, Gewerk, Preis), falls die Kategorie einer Leistung entspricht
  serviceId          String?
  service            Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  urgency            String     @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  summary            String?
  transcript         String?
  appointmentStart   DateTime?
  appointmentEnd     DateTime?
  calendarEventId    String? // Microsoft-365-Event (falls verbunden)
  emailDraftId       String? // Microsoft-365-Entwurf (falls verbunden)
  /// Terminerinnerung versendet (bzw. bewusst übersprungen) für den Termin appointmentStart
  reminderSentAt     DateTime?
  /// Antwort des Kunden auf „Passt es noch?“ (CONFIRMED, DECLINED) per SMS
  confirmation       String?
  confirmationAt     DateTime?
  /// Erledigt gemeldet (Büro setzt „Abgeschlossen“ oder Techniker-App) – Auslöser für die Bitte um Bewertung
  closedAt           DateTime?
  /// Bitte um Bewertung geprüft (gesendet oder bewusst übersprungen)
  reviewHandledAt    DateTime?
  status             String     @default("PENDING") // PENDING, PROCESSED, ESCALATED, CLOSED
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  messages           Message[]
  bills              Bill[]
  jobReport          JobReport?
  tasks              Task[]

  @@index([tenantId, createdAt])
  @@index([assignedEmployeeId, appointmentStart])
}

/// Protokoll aller ausgehenden Benachrichtigungen (E-Mail, SMS) – auch wenn kein Versanddienst konfiguriert ist.
model Message {
  id            String      @id @default(cuid())
  tenantId      String?
  tenant        Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketId      String?
  ticket        CallTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  channel       String // EMAIL, SMS
  recipient     String
  subject       String?
  body          String
  purpose       String // CUSTOMER_CONFIRMATION, TECHNICIAN_BRIEFING, EMERGENCY_ALERT, INVITE, PASSWORD_RESET
  status        String      @default("QUEUED") // QUEUED, SENT, DRAFT, FAILED, SKIPPED
  provider      String? // smtp, twilio, microsoft
  error         String?
  /// Zustellversuche; nach einem Fehler erneut ab nextAttemptAt (Cron /api/cron/notify)
  attempts      Int         @default(0)
  nextAttemptAt DateTime?
  /// Versanddetails für Wiederholungen (Absendername, Antwortadresse, Kalenderanhang)
  meta          Json?
  createdAt     DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@index([status, nextAttemptAt])
}

/// Plattform-Einstellungen aus der Oberfläche (überschreiben gleichnamige Umgebungsvariablen).
/// Geheime Werte sind mit APP_ENCRYPTION_KEY verschlüsselt.
model PlatformSetting {
  key       String   @id
  value     String
  secret    Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/// Paket / Tarif. Beträge in Cent (netto).
model Plan {
  id                    String   @id @default(cuid())
  key                   String   @unique
  name                  String
  description           String   @default("")
  active                Boolean  @default(true)
  monthlyPriceCents     Int
  setupFeeCents         Int      @default(0)
  includedMinutes       Int
  overageCentsPerMinute Int
  /// CHARGE = Überminuten berechnen, BLOCK = nach Kontingent an Fallback weiterleiten
  overageMode           String   @default("CHARGE")
  /// Abrechnungstakt in Sekunden je Gespräch (60 = jede angefangene Minute)
  billingIncrementSec   Int      @default(60)
  includedSms           Int      @default(0)
  smsCents              Int      @default(0)
  maxNumbers            Int?
  maxUsers              Int?
  features              String[] @default([])
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenants               Tenant[]
}

/// Betriebszustand: Lebenszeichen von Jobs (z. B. Backup) und zuletzt gesendete Alarme (gegen Alarmfluten).
model SystemState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Anfrage-Zähler für sicherheitsrelevante Limits (Anmeldung, 2FA, Passwort-Reset …), gemeinsam für alle Instanzen.
model RateLimitHit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

/// Monatsabschluss je Kunde (GoBD, docs/recht/loeschkonzept.md §5): festgeschriebene Summen ohne
/// Anruferdaten. Bewusst ohne Fremdschlüssel – bleibt auch nach Löschung des Kunden erhalten.
model BillingSnapshot {
  id         String   @id @default(cuid())
  tenantId   String
  tenantName String
  year       Int
  month      Int
  planName   String
  usage      Json
  invoice    Json
  /// Schlussabrechnung beim Löschen des Kunden (Monat noch nicht zu Ende)
  partial    Boolean  @default(false)
  closedAt   DateTime @default(now())

  @@unique([tenantId, year, month])
}

/// Zusätzlich gebuchte Minuten für einen Kalendermonat (Kunden-Admin, Selbstbedienung)
model MinuteTopUp {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  minutes     Int
  priceCents  Int
  createdById String?
  createdAt   DateTime @default(now())

  @@index([tenantId, year, month])
}

/// Wunsch eines Kunden nach einem anderen Paket – der Betreiber nimmt an oder lehnt ab
model PlanChangeRequest {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId      String
  planName    String
  note        String    @default("")
  /// OPEN, APPROVED, REJECTED
  status      String    @default("OPEN")
  createdById String?
  createdAt   DateTime  @default(now())
  handledAt   DateTime?
  handledById String?

  @@index([status, createdAt])
}

/// Webhook eines Kunden: Ereignisse (Vorgang angelegt/geändert, Anruf beendet) an eigene Systeme
model WebhookEndpoint {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url        String
  /// Signatur-Geheimnis, verschlüsselt (secret-box)
  secretEnc  String
  events     String[]
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  lastStatus String?
  lastAt     DateTime?
  deliveries WebhookDelivery[]

  @@index([tenantId])
}

/// Zustellung eines Webhook-Ereignisses mit Wiederholung (Cron „notify“)
model WebhookDelivery {
  id            String          @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event         String
  payload       Json
  /// QUEUED, SENT, FAILED
  status        String          @default("QUEUED")
  attempts      Int             @default(0)
  nextAttemptAt DateTime?
  lastError     String?
  createdAt     DateTime        @default(now())

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

/// Rechnung – unveränderlich nach Ausstellung (GoBD), ohne Fremdschlüssel: bleibt nach Löschung des Kunden
model Invoice {
  id         String   @id @default(cuid())
  /// fortlaufend je Jahr, z. B. 2026-0001
  number     String   @unique
  tenantId   String
  year       Int
  month      Int
  issuedAt   DateTime @default(now())
  dueAt      DateTime
  /// Aussteller und Empfänger zum Zeitpunkt der Ausstellung
  issuer     Json
  recipient  Json
  lines      Json
  netCents   Int
  vatPercent Float
  vatCents   Int
  grossCents Int
  /// Schlussrechnung beim Löschen des Kunden (Monat nicht zu Ende)
  partial    Boolean  @default(false)

  @@unique([tenantId, year, month])
  @@index([year, month])
}

/// Zähler für fortlaufende Rechnungsnummern je Jahr
model InvoiceCounter {
  year Int @id
  last Int @default(0)
}

/// Leistungskatalog je Betrieb: Dauer für die Terminbuchung, Gewerk für die Zuständigkeit, Preis für Rechnungen.
model Service {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  /// Weitere Begriffe, unter denen die KI die Leistung erkennt (kommagetrennt)
  aliases     String       @default("")
  trade       String       @default("")
  durationMin Int          @default(60)
  /// Netto-Einzelpreis in Cent; 0 = nach Aufwand
  priceCents  Int          @default(0)
  unit        String       @default("pauschal")
  taxRate     Int          @default(19)
  active      Boolean      @default(true)
  sort        Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tickets     CallTicket[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

/**
 * Belege des Betriebs an seine Endkunden: Angebot, Rechnung, Gutschrift (Storno).
 * Entwurf = frei änderbar, ohne Nummer. Ausstellen vergibt die fortlaufende Nummer und friert
 * Aussteller, Empfänger und Positionen ein (GoBD); danach nur noch Statuswechsel
 * (bezahlt, gemahnt) und Storno per Gutschrift. Beträge werden immer serverseitig berechnet.
 */
model Bill {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// QUOTE, INVOICE, CREDIT_NOTE
  kind           String      @default("INVOICE")
  /// DRAFT, ISSUED, PAID, CANCELLED (Rechnung storniert), ACCEPTED, DECLINED (Angebot)
  status         String      @default("DRAFT")
  number         String?
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id], onDelete: NoAction)
  ticketId       String?
  ticket         CallTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  /// Gutschrift → stornierte Rechnung; Rechnung → Angebot, aus dem sie entstand
  relatedId      String?
  issueDate      DateTime?
  serviceDate    DateTime?
  dueAt          DateTime?
  issuer         Json?
  recipient      Json?
  lines          Json        @default("[]")
  netCents       Int         @default(0)
  taxCents       Int         @default(0)
  grossCents     Int         @default(0)
  taxes          Json        @default("[]")
  smallBusiness  Boolean     @default(false)
  introText      String?
  note           String?
  paidAt         DateTime?
  paymentMethod  String?
  reminderLevel  Int         @default(0)
  lastReminderAt DateTime?
  sentAt         DateTime?
  /// Link für den Kunden (Ansicht, Druck, GiroCode) – zufällig, nicht erratbar
  publicToken    String      @unique
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([tenantId, number])
  @@index([tenantId, kind, status])
  @@index([status, dueAt])
}

/// Fortlaufende Nummern je Betrieb, Jahr und Belegart (RE, AN, GS)
model BillCounter {
  tenantId String
  year     Int
  kind     String
  last     Int    @default(0)

  @@id([tenantId, year, kind])
}

/// Einsatzbericht aus der Techniker-App (ein Bericht je Vorgang)
model JobReport {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketId        String     @unique
  ticket          CallTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  employeeId      String?
  employee        Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  status          String     @default("OPEN") // OPEN, EN_ROUTE, ON_SITE, DONE
  enRouteAt       DateTime?
  arrivedAt       DateTime?
  finishedAt      DateTime?
  findings        String     @default("")
  workDone        String     @default("")
  /// [{ description, quantity, unit, unitCents, serviceId? }]
  materials       Json       @default("[]")
  hoursWorked     Float      @default(0)
  signatureName   String?
  signaturePng    Bytes?
  signedAt        DateTime?
  billId          String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  photos          JobPhoto[]

  @@index([tenantId, updatedAt])
}

model JobPhoto {
  id        String    @id @default(cuid())
  tenantId  String
  reportId  String
  report    JobReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  sizeBytes Int
  createdAt DateTime  @default(now())

  @@index([reportId])
}

/// Techniker-App: SHA-256 des Geräte-Links (/t/{token}); eigene Tabelle, damit der Hash nie mit Mitarbeiterdaten ausgeliefert wird
model EmployeeAppToken {
  hash       String   @id
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenantId   String
  createdAt  DateTime @default(now())
}

/// Preis und Verfügbarkeit einer Zusatzoption (Name/Beschreibung im Code: src/lib/addons.ts)
model AddonPrice {
  key               String   @id
  monthlyPriceCents Int
  active            Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

/// Gebuchte Zusatzoption eines Kunden; endsAt = gekündigt zum Monatsende
model TenantAddon {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key        String
  /// Monatspreis zum Zeitpunkt der Buchung (0 = vom Betreiber kostenlos freigeschaltet)
  priceCents Int
  startedAt  DateTime  @default(now())
  endsAt     DateTime?
  bookedById String?
  createdAt  DateTime  @default(now())

  @@index([tenantId, key])
}

/// Zahlungseingang aus einem hochgeladenen Kontoauszug – nur zugeordnete bzw. vorgeschlagene Gutschriften (Datensparsamkeit), 90 Tage
model BankTransaction {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SHA-256 aus Datum, Betrag, Verwendungszweck, Name – verhindert doppelte Verarbeitung beim erneuten Import
  hash         String
  bookingDate  DateTime
  amountCents  Int
  counterparty String   @default("")
  reference    String   @default("")
  /// MATCHED (automatisch bezahlt), SUGGESTED (bitte prüfen), ACCEPTED, IGNORED
  status       String
  billId       String?
  reason       String   @default("")
  createdAt    DateTime @default(now())

  @@unique([tenantId, hash])
  @@index([tenantId, status])
}

/// Geokodierte Adressen (Schlüssel = SHA-256 der normalisierten Adresse, keine Klartextadresse), 180 Tage
model GeoCache {
  key       String   @id
  lat       Float?
  lon       Float?
  /// ors, osm, none (nicht gefunden)
  provider  String
  createdAt DateTime @default(now())
}

/// Aufgaben (Mein Tag): manuell oder aus einem Vorgang, optional einer Person zugeordnet
model Task {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  note         String      @default("")
  dueAt        DateTime?
  assigneeId   String?
  assignee     User?       @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  ticketId     String?
  ticket       CallTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  doneAt       DateTime?
  createdById  String?
  createdAt    DateTime    @default(now())

  @@index([tenantId, doneAt])
  @@index([assigneeId, doneAt])
}
